# Local server only. No credentials are required to start PocketBase.
PB_HTTP=127.0.0.1:8090
# Optional absolute Python 3 executable for XLSX. pb.py defaults to its own interpreter.
# PB_PYTHON=C:/path/to/python.exe
# Application business timezone (validity is evaluated in this timezone).
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Reserved for the future Next.js server integration; never NEXT_PUBLIC_* secrets.
POCKETBASE_URL=http://127.0.0.1:8090
